# Normalize line endings; keep shell scripts and game scripts LF.
* text=auto eol=lf
*.png binary
*.ico binary
*.7z binary
*.exe binary
*.dll binary

# If you install Git LFS and want to commit content/tribesinstall.7z, remove the
# matching line in .gitignore and uncomment:
# *.7z filter=lfs diff=lfs merge=lfs -text
