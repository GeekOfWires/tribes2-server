# ---------------------------------------------------------------------------
# Copy to .env and fill in. `docker compose` reads this automatically.
# ---------------------------------------------------------------------------

# --- Tribes 2 patch (the build "variable") --------------------------------
# NSIS installer .exe; its payload is 7z-extracted over GameData at build time.
PATCH_URL=https://www.tribesnext.com/files/TribesNEXT_20250922_preview.exe
PATCH_SHA256=
WINE_BRANCH=stable

# --- Game launch ------------------------------------------------------------
# Order matters: -online (or -nologin) FIRST, -dedicated LAST, mods in between.
LAUNCH_PARAMS=-online -dedicated
TELNET_PORT=23000
# Leave blank to auto-generate random per-boot console passwords (recommended).
TELNET_CONSOLE_PASS=
TELNET_LISTEN_PASS=
GRACE_SECONDS=20
RESTART_ON_CRASH=true

# --- Panel HTTP/HTTPS host ports -------------------------------------------
PANEL_HTTP_PORT=8080
PANEL_HTTPS_PORT=8443
GAME_PORT=28000

# --- Initial root user (seeded once on first boot) --------------------------
# root performs first-time server setup in the panel; the game won't run until then.
ROOT_USERNAME=root
ROOT_PASSWORD=change-me-now

# --- TLS: self-signed (set SELF_SIGNED_CERT=1 to enable) --------------------
SELF_SIGNED_CERT=0
SELF_SIGNED_SUBJECT=         # e.g. CN=tribes2.example.com  (overrides SELF_SIGNED_CN)
SELF_SIGNED_CN=tribes2-panel
SELF_SIGNED_DNS=             # comma list of DNS SANs, e.g. tribes2.example.com,www.example.com
SELF_SIGNED_IP=              # comma list of IP SANs, e.g. 203.0.113.10
SELF_SIGNED_DAYS=365
SELF_SIGNED_PASSWORD=

# --- TLS: Let's Encrypt (set LETS_ENCRYPT_CERT=1 to enable) -----------------
# Needs the HTTPS port reachable from the internet for ACME (HTTP-01 on :80/HTTP_PORT).
LETS_ENCRYPT_CERT=0
LETS_ENCRYPT_EMAIL=
LETS_ENCRYPT_DOMAINS=        # comma list of DNS names (or IPs where supported)
LETS_ENCRYPT_STAGING=0       # 1 = use the LE staging CA while testing
